#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(pwd -P)"

mkdir -p "$SCRIPT_DIR/.agents/claude"
touch "$SCRIPT_DIR/.agents/claude.json"

exec docker run --rm -it \
    --mount "type=bind,source=${PROJECT_DIR},target=/workspace" \
    --mount "type=bind,source=${SCRIPT_DIR}/.agents/claude,target=/root/.claude" \
    --mount "type=bind,source=${SCRIPT_DIR}/.agents/claude.json,target=/root/.claude.json" \
    -w /workspace \
    dev-agents:latest \
    claude "$@"
