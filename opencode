#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(pwd -P)"

mkdir -p \
    "$SCRIPT_DIR/.agents/opencode/config" \
    "$SCRIPT_DIR/.agents/opencode/data"

exec docker run --rm -it \
    --mount "type=bind,source=${PROJECT_DIR},target=/workspace" \
    --mount "type=bind,source=${SCRIPT_DIR}/.agents/opencode/config,target=/root/.config/opencode" \
    --mount "type=bind,source=${SCRIPT_DIR}/.agents/opencode/data,target=/root/.local/share/opencode" \
    -w /workspace \
    dev-agents:latest \
    opencode "$@"
