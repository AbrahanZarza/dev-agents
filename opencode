#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

set -a
source .env
set +a

WORKSPACE="$(cd "$AGENTS_WORKSPACE" && pwd)"

exec docker run --rm -it \
    --mount "type=bind,source=${WORKSPACE},target=/workspace" \
    -v "${SCRIPT_DIR}/.agents/opencode/config:/root/.config/opencode" \
    -v "${SCRIPT_DIR}/.agents/opencode/data:/root/.local/share/opencode" \
    -w /workspace \
    dev-agents:latest \
    opencode "$@"
