#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(pwd -P)"

if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo
    echo "⚠️ WARNING: the current directory maybe is not a Git repository."
    echo "Current directory: $PROJECT_DIR"
    echo
    echo "The agent can access all files in this directory."
    echo

    read -r -p "¿Are you sure to run the agent? [y/N] " answer

    case "$answer" in
        y|Y|yes|YES|Yes)
            echo "Executing the agent..."
            ;;
        *)
            echo "Stopped execution."
            exit 1
            ;;
    esac
fi

exec docker run --rm -it \
    --mount "type=bind,source=${PROJECT_DIR},target=/workspace" \
    -v "${SCRIPT_DIR}/.agents/opencode/config:/root/.config/opencode" \
    -v "${SCRIPT_DIR}/.agents/opencode/data:/root/.local/share/opencode" \
    -w /workspace \
    dev-agents:latest \
    opencode "$@"
